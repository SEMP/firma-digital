#!/usr/bin/env python3
"""Firma un PDF con el token Bit4id replicando lo que hace Adobe Acrobat.

Por defecto abre una ventana para elegir con el mouse donde va el sello visible.
  firmar-pdf entrada.pdf salida.pdf                    -> selector visual
  firmar-pdf entrada.pdf salida.pdf --caja 1:340,70,560,140  -> sin ventana (lotes)
  firmar-pdf entrada.pdf salida.pdf --invisible        -> sin sello ni ventana

Parametros verificados contra un PDF firmado en la HP con Acrobat (2026-09-18):
  - SubFilter  adbe.pkcs7.detached   (NO PAdES/ETSI)
  - Digest     SHA-256
  - Sin sello de tiempo (no usan TSA)
  - "Bloquear documento tras la firma" = FieldMDP /Action /All + /P 1
    (es firma de APROBACION con bloqueo de campos, NO una certificacion DocMDP)
"""
import argparse
import configparser
import getpass
from datetime import datetime
import os
import pathlib
import subprocess
import sys
import tempfile

from pyhanko.pdf_utils import layout, text as pdftext
from pyhanko.pdf_utils.font.basic import SimpleFontEngineFactory
from pyhanko.pdf_utils.incremental_writer import IncrementalPdfFileWriter
from pyhanko.sign import fields, signers
from pyhanko.sign.pkcs11 import PKCS11Signer, TokenCriteria, open_pkcs11_session
from pyhanko.sign.signers.pdf_signer import PdfSigner
from pyhanko.stamp import TextStampStyle

# --- Configuracion -----------------------------------------------------------
# Nada de esto es obligatorio: si no se configura, el modulo PKCS#11 se busca
# entre las rutas conocidas y los objetos del token se detectan solos (pyHanko
# consulta por clase y, si hay un unico certificado/clave, lo toma). Un token
# personal de firma tiene exactamente uno, asi que el caso normal no necesita
# configurar nada.
#
# Orden de precedencia: flags de linea de comandos > variables de entorno >
# ~/.config/firma-digital/config.ini > autodeteccion.

RUTAS_PKCS11 = [
    "/usr/lib/bit4id/libbit4xpki.so",              # middleware Bit4id
    "/usr/lib/x86_64-linux-gnu/opensc-pkcs11.so",  # OpenSC (generico)
    "/usr/lib/opensc-pkcs11.so",
    "/usr/local/lib/libbit4xpki.so",
]

CONFIG = pathlib.Path(
    os.environ.get("XDG_CONFIG_HOME", "~/.config")
).expanduser() / "firma-digital" / "config.ini"


def _config_archivo():
    if not CONFIG.is_file():
        return {}
    cp = configparser.ConfigParser()
    cp.read(CONFIG)
    return dict(cp["token"]) if cp.has_section("token") else {}


def resolver_token(args):
    """Devuelve (lib, token_label, cert_label, key_label). None = autodetectar."""
    arch = _config_archivo()

    def opt(nombre, valor_cli):
        if valor_cli:
            return valor_cli
        env = os.environ.get("FIRMA_" + nombre.upper())
        if env:
            return env
        return arch.get(nombre) or None

    lib = opt("lib", args.lib)
    if lib is None:
        lib = next((r for r in RUTAS_PKCS11 if os.path.exists(r)), None)
        if lib is None:
            raise SystemExit(
                "No se encontro ningun modulo PKCS#11. Instala el middleware de "
                "tu token e indicalo con --lib, la variable FIRMA_LIB, o "
                f"la clave 'lib' en {CONFIG}"
            )
    return lib, opt("token_label", args.token_label), \
        opt("cert_label", args.cert_label), opt("key_label", args.key_label)

# Mismo texto que muestra Acrobat, en castellano.
TEXTO_SELLO = "Firmado digitalmente por\n%(signer)s\nFecha: %(ts)s"
FORMATO_FECHA = "%Y.%m.%d %H:%M:%S %z"
# Helvetica es una de las 14 fuentes estandar de PDF: se referencia sin incrustar.
# pyHanko solo trae metricas de Courier (COURIER_META); sin meta el ancho es
# aproximado, lo que solo afecta el calculo de encaje en la caja.
# Anchos reales de Helvetica (AFM estandar, en milesimas de em) para ASCII
# imprimible. Hacen falta porque pyHanko estima el ancho como
# len(texto)*avg_width -- un ratio plano, ver SimpleFontEngine.shape() -- y con
# un valor fijo el sello queda recortado (si subestima) o con espacio de sobra
# (si sobreestima). El espacio mide 278, no ~500: es la diferencia mas grande.
_W = {
    " ": 278, "!": 278, '"': 355, "#": 556, "$": 556, "%": 889, "&": 667,
    "'": 191, "(": 333, ")": 333, "*": 389, "+": 584, ",": 278, "-": 333,
    ".": 278, "/": 278, ":": 278, ";": 278, "<": 584, "=": 584, ">": 584,
    "?": 556, "@": 1015, "[": 278, "\\": 278, "]": 278, "^": 469, "_": 556,
    "`": 333, "{": 334, "|": 260, "}": 334, "~": 584,
    "A": 667, "B": 667, "C": 722, "D": 722, "E": 667, "F": 611, "G": 778,
    "H": 722, "I": 278, "J": 500, "K": 667, "L": 556, "M": 833, "N": 722,
    "O": 778, "P": 667, "Q": 778, "R": 722, "S": 667, "T": 611, "U": 722,
    "V": 667, "W": 944, "X": 667, "Y": 667, "Z": 611,
    "a": 556, "b": 556, "c": 500, "d": 556, "e": 556, "f": 278, "g": 556,
    "h": 556, "i": 222, "j": 222, "k": 500, "l": 222, "m": 833, "n": 556,
    "o": 556, "p": 556, "q": 556, "r": 333, "s": 500, "t": 278, "u": 556,
    "v": 500, "w": 722, "x": 500, "y": 500, "z": 500,
}
_W.update({str(d): 556 for d in range(10)})
# acentuadas y enie: mismo ancho que la letra base (asi es en Helvetica)
for _con, _sin in (("ÁÀÂÄÃ", "A"), ("ÉÈÊË", "E"), ("ÍÌÎÏ", "I"),
                   ("ÓÒÔÖÕ", "O"), ("ÚÙÛÜ", "U"), ("Ñ", "N"), ("Ç", "C"),
                   ("áàâäã", "a"), ("éèêë", "e"), ("íìîï", "i"),
                   ("óòôöõ", "o"), ("úùûü", "u"), ("ñ", "n"), ("ç", "c")):
    _W.update({c: _W[_sin] for c in _con})


def ancho_em(texto):
    """Ancho del texto en em. Multiplicado por el cuerpo, da puntos."""
    return sum(_W.get(c, 556) for c in texto) / 1000.0


def fuente(textos):
    """Helvetica con el avg_width promedio REAL de este texto.

    pyHanko usa un unico ratio por fuente para ubicar el bloque dentro de la
    caja; calcularlo sobre el texto concreto hace que el centrado sea correcto.
    """
    juntos = "".join(textos) or " "
    return SimpleFontEngineFactory("Helvetica", ancho_em(juntos) / len(juntos))


# Margen interno del sello. pyHanko usa 10 por defecto (DEFAULT_TEXT_BOX_MARGIN),
# que en una caja chica se come buena parte del ancho util; lo fijamos nosotros
# para que coincida con el que usa cuerpo_que_entra() y con la previsualizacion.
MARGEN_SELLO = 2

# Interlineado como multiplo del cuerpo. pyHanko usa leading = font_size cuando
# no se indica (TextStyle.leading), o sea 1.0: apretado. Lo fijamos explicito
# para que el calculo del cuerpo, el render y la previsualizacion coincidan.
INTERLINEA = 1.2

# Proporciones de Helvetica usadas para ubicar la previsualizacion por linea
# base. pyHanko apoya la linea base del ultimo renglon sobre el margen inferior
# (medido: 1.4 pt en una caja de 220x70), asi que reservar una caja de linea
# completa deja aire de mas: el descendente de esa ultima linea no se usa.
ALTURA_MAYUSCULA = 0.717
DESCENDENTE = 0.21

# Alineacion del bloque de texto dentro del recuadro marcado.
ALINEACIONES = {
    "abajo-izq": ("min", "min"),
    "abajo-centro": ("mid", "min"),
    "centro": ("mid", "mid"),
    "arriba-izq": ("min", "max"),
}
_EJES = {"min": layout.AxisAlignment.ALIGN_MIN,
         "mid": layout.AxisAlignment.ALIGN_MID,
         "max": layout.AxisAlignment.ALIGN_MAX}


def regla_de_caja(alineacion):
    x, y = ALINEACIONES[alineacion]
    return layout.SimpleBoxLayoutRule(
        x_align=_EJES[x], y_align=_EJES[y],
        margins=layout.Margins.uniform(MARGEN_SELLO),
    )


def cuerpo_que_entra(lineas, ancho_pt, alto_pt, maximo=14, minimo=4):
    """Cuerpo de letra mas grande con el que las lineas entran en la caja."""
    margen = MARGEN_SELLO
    util_x = max(1.0, ancho_pt - 2 * margen)
    util_y = max(1.0, alto_pt - 2 * margen)
    por_ancho = util_x / max(ancho_em(l) for l in lineas)
    por_alto = util_y / (len(lineas) * INTERLINEA)
    return max(minimo, min(maximo, int(min(por_ancho, por_alto))))

ZOOM_MIN, ZOOM_MAX = 0.25, 4.0


def parse_caja(valor):
    """'PAGINA:X1,Y1,X2,Y2' o 'X1,Y1,X2,Y2' (pagina 1). Puntos PDF, origen
    abajo-izquierda de la pagina."""
    pagina = 1
    if ":" in valor:
        pagina_txt, valor = valor.split(":", 1)
        pagina = int(pagina_txt)
    partes = [int(v) for v in valor.split(",")]
    if len(partes) != 4:
        raise argparse.ArgumentTypeError(
            "la caja va como PAGINA:X1,Y1,X2,Y2 (ej. 1:340,70,560,140)"
        )
    if pagina < 1:
        raise argparse.ArgumentTypeError("la pagina se numera desde 1")
    return pagina, tuple(partes)


def elegir_caja(pdf, pagina=1, nombre=None, alineacion="abajo-izq"):
    """Ventana con la pagina renderizada; devuelve (pagina, caja) o None.

    El rectangulo se arrastra con el mouse, igual que en Acrobat. Las
    coordenadas salen en puntos PDF con origen abajo-izquierda, que es lo que
    espera SigFieldSpec.
    """
    import tkinter as tk
    from pyhanko.pdf_utils.reader import PdfFileReader

    with open(pdf, "rb") as fh:
        total = PdfFileReader(fh).root["/Pages"]["/Count"]

    lineas = lineas_del_sello(nombre)
    tmp = tempfile.mkdtemp(prefix="firmar-pdf-")
    estado = {"pagina": max(1, min(pagina, total)), "caja": None, "ok": False,
              "zoom": None}

    root = tk.Tk()
    root.title(f"Elegir area de la firma — {pathlib.Path(pdf).name}")
    pant_w = root.winfo_screenwidth()
    pant_h = root.winfo_screenheight()
    max_w, max_h = pant_w - 120, pant_h - 220

    barra = tk.Frame(root)
    barra.pack(fill="x", padx=6, pady=4)
    etiqueta = tk.Label(barra, text="", anchor="w")

    marco = tk.Frame(root)
    marco.pack(fill="both", expand=True)
    vbar = tk.Scrollbar(marco, orient="vertical")
    hbar = tk.Scrollbar(marco, orient="horizontal")
    lienzo = tk.Canvas(marco, cursor="crosshair", highlightthickness=0,
                       background="#888",
                       yscrollcommand=vbar.set, xscrollcommand=hbar.set)
    vbar.config(command=lienzo.yview)
    hbar.config(command=lienzo.xview)
    vbar.pack(side="right", fill="y")
    hbar.pack(side="bottom", fill="x")
    lienzo.pack(side="left", fill="both", expand=True)

    vista = {"img": None, "dpi": 72.0, "alto_px": 0, "rect": None,
             "pt": (595.0, 842.0)}

    def medir_pagina(n):
        """Renderiza a 72 dpi: 1 px == 1 pt, asi sale el tamano en puntos."""
        sonda = f"{tmp}/sonda.png"
        subprocess.run(["mutool", "draw", "-r", "72", "-o", sonda, pdf, str(n)],
                       check=True, capture_output=True)
        img = tk.PhotoImage(file=sonda)
        return float(img.width()), float(img.height())

    def render():
        n = estado["pagina"]
        ancho_pt, alto_pt = medir_pagina(n)
        vista["pt"] = (ancho_pt, alto_pt)
        if estado["zoom"] is None:
            # encajar la pagina entera en pantalla, sin ampliar de mas
            estado["zoom"] = min(max_w / ancho_pt, max_h / alto_pt, 2.0)
        dpi = 72.0 * estado["zoom"]
        png = f"{tmp}/p{n}_{dpi:.0f}.png"
        subprocess.run(["mutool", "draw", "-r", f"{dpi:.2f}", "-o", png, pdf, str(n)],
                       check=True, capture_output=True)
        img = tk.PhotoImage(file=png)
        vista.update(img=img, dpi=dpi, alto_px=img.height())
        lienzo.delete("all")
        lienzo.create_image(0, 0, anchor="nw", image=img)
        lienzo.config(scrollregion=(0, 0, img.width(), img.height()))
        lienzo.config(width=min(img.width(), max_w), height=min(img.height(), max_h))
        vista["rect"] = None
        estado["caja"] = None
        actualizar()

    def a_puntos(x_px, y_px):
        f = 72.0 / vista["dpi"]
        return x_px * f, (vista["alto_px"] - y_px) * f

    def dibujar_preview():
        """Muestra el sello como va a quedar: mismo cuerpo de letra calculado."""
        lienzo.delete("preview")
        c = estado["caja"]
        if not c:
            return None
        ancho_pt, alto_pt = c[2] - c[0], c[3] - c[1]
        cuerpo = cuerpo_que_entra(lineas, ancho_pt, alto_pt)
        px = cuerpo * vista["dpi"] / 72.0
        x0, y0, x1, y1 = lienzo.coords(vista["rect"])
        x0, x1 = min(x0, x1), max(x0, x1)
        y0, y1 = min(y0, y1), max(y0, y1)
        m = MARGEN_SELLO * vista["dpi"] / 72.0
        interlinea = px * INTERLINEA
        n = len(lineas)
        # alto de la tinta: los saltos entre lineas mas la altura de mayuscula
        # de la primera. El descendente de la ultima no cuenta.
        alto_tinta = (n - 1) * interlinea + px * ALTURA_MAYUSCULA
        ejes_x, ejes_y = ALINEACIONES[alineacion]
        if ejes_x == "min":
            anclaje, x = "sw", x0 + m
        else:
            anclaje, x = "s", (x0 + x1) / 2
        if ejes_y == "min":          # abajo: y crece hacia abajo en el canvas
            base_ultima = y1 - m
        elif ejes_y == "max":
            base_ultima = y0 + m + alto_tinta
        else:
            base_ultima = (y0 + y1 + alto_tinta) / 2
        # Tk ubica el ancla "s" en el borde inferior del recuadro del texto, que
        # cae un descendente por debajo de la linea base
        desplazamiento = px * DESCENDENTE
        for i, linea in enumerate(lineas):
            base = base_ultima - (n - 1 - i) * interlinea
            lienzo.create_text(
                x, base + desplazamiento, anchor=anclaje,
                text=linea, font=("Helvetica", -max(1, int(round(px)))),
                fill="#000", tags="preview")
        return cuerpo

    def actualizar():
        c = estado["caja"]
        base = f"Pagina {estado['pagina']}/{total}  ·  {estado['zoom']*100:.0f}%"
        if c is None:
            txt = f"{base}  ·  arrastra el area de la firma"
        else:
            cuerpo = dibujar_preview()
            txt = (f"{base}  ·  letra {cuerpo} pt  ·  "
                   f"--caja {estado['pagina']}:{c[0]},{c[1]},{c[2]},{c[3]}")
        etiqueta.config(text=txt)
        boton_ok.config(state="normal" if c else "disabled")

    inicio = {}

    def press(e):
        inicio["x"], inicio["y"] = lienzo.canvasx(e.x), lienzo.canvasy(e.y)
        lienzo.delete("preview")
        if vista["rect"]:
            lienzo.delete(vista["rect"])
        vista["rect"] = lienzo.create_rectangle(
            inicio["x"], inicio["y"], inicio["x"], inicio["y"],
            outline="#0a7", width=2, dash=(4, 3))

    def drag(e):
        if not vista["rect"]:
            return
        lienzo.coords(vista["rect"], inicio["x"], inicio["y"],
                      lienzo.canvasx(e.x), lienzo.canvasy(e.y))

    def release(e):
        if not vista["rect"]:
            return
        x0, y0, x1, y1 = lienzo.coords(vista["rect"])
        if abs(x1 - x0) < 8 or abs(y1 - y0) < 8:
            lienzo.delete(vista["rect"])
            vista["rect"] = None
            estado["caja"] = None
        else:
            ax, ay = a_puntos(min(x0, x1), max(y0, y1))
            bx, by = a_puntos(max(x0, x1), min(y0, y1))
            estado["caja"] = (round(ax), round(ay), round(bx), round(by))
        actualizar()

    def scroll_v(e):
        # Boton 4/5 en X11, delta en otros toolkits
        if getattr(e, "num", None) == 4 or getattr(e, "delta", 0) > 0:
            lienzo.yview_scroll(-3, "units")
        elif getattr(e, "num", None) == 5 or getattr(e, "delta", 0) < 0:
            lienzo.yview_scroll(3, "units")

    def scroll_h(e):
        if getattr(e, "num", None) == 4 or getattr(e, "delta", 0) > 0:
            lienzo.xview_scroll(-3, "units")
        else:
            lienzo.xview_scroll(3, "units")

    def zoom(factor):
        estado["zoom"] = max(ZOOM_MIN, min(ZOOM_MAX, estado["zoom"] * factor))
        render()

    def zoom_ajustar():
        ancho_pt, alto_pt = vista["pt"]
        estado["zoom"] = min(max_w / ancho_pt, max_h / alto_pt, 2.0)
        render()

    lienzo.bind("<ButtonPress-1>", press)
    lienzo.bind("<B1-Motion>", drag)
    lienzo.bind("<ButtonRelease-1>", release)
    for ev in ("<Button-4>", "<Button-5>", "<MouseWheel>"):
        root.bind_all(ev, scroll_v)
    for ev in ("<Shift-Button-4>", "<Shift-Button-5>", "<Shift-MouseWheel>"):
        root.bind_all(ev, scroll_h)

    def confirmar():
        estado["ok"] = True
        root.destroy()

    def pagina_delta(d):
        nueva = estado["pagina"] + d
        if 1 <= nueva <= total:
            estado["pagina"] = nueva
            render()

    tk.Button(barra, text="<", width=3, command=lambda: pagina_delta(-1)).pack(side="left")
    tk.Button(barra, text=">", width=3, command=lambda: pagina_delta(1)).pack(side="left")
    tk.Button(barra, text="−", width=3, command=lambda: zoom(1 / 1.25)).pack(side="left", padx=(8, 0))
    tk.Button(barra, text="+", width=3, command=lambda: zoom(1.25)).pack(side="left")
    tk.Button(barra, text="Ajustar", command=zoom_ajustar).pack(side="left", padx=4)
    boton_ok = tk.Button(barra, text="Firmar aqui", command=confirmar, state="disabled")
    boton_ok.pack(side="right")
    tk.Button(barra, text="Cancelar", command=root.destroy).pack(side="right", padx=4)
    etiqueta.pack(side="left", padx=10)

    root.bind("<Escape>", lambda e: root.destroy())
    root.bind("<Return>", lambda e: confirmar() if estado["caja"] else None)
    root.bind("<Prior>", lambda e: pagina_delta(-1))
    root.bind("<Next>", lambda e: pagina_delta(1))

    render()
    root.update_idletasks()
    root.geometry(f"+{max(0, (pant_w - root.winfo_width()) // 2)}+40")
    root.mainloop()
    return (estado["pagina"], estado["caja"]) if estado["ok"] else None





def leer_nombre_del_token(lib, token_label=None, cert_label=None):
    """CN del certificado, leido SIN PIN.

    Los certificados son objetos publicos del token: se pueden leer con la
    sesion sin autenticar (open_pkcs11_session con user_pin=None no hace login).
    Sirve para previsualizar el sello antes de pedir el PIN. Devuelve None si
    no se pudo leer: la previsualizacion usa un texto generico y listo.
    """
    try:
        from asn1crypto import x509 as asn1x509
        from pkcs11 import Attribute, ObjectClass

        criterio = TokenCriteria(label=token_label) if token_label else None
        sesion = open_pkcs11_session(lib, token_criteria=criterio, user_pin=None)
        try:
            consulta = {Attribute.CLASS: ObjectClass.CERTIFICATE}
            if cert_label:
                consulta[Attribute.LABEL] = cert_label
            for obj in sesion.get_objects(consulta):
                cert = asn1x509.Certificate.load(bytes(obj[Attribute.VALUE]))
                cn = cert.subject.native.get("common_name")
                if cn:
                    return cn
        finally:
            sesion.close()
    except Exception:
        pass
    return None


def lineas_del_sello(nombre):
    return (TEXTO_SELLO % {
        "signer": nombre or "NOMBRE DEL FIRMANTE",
        "ts": datetime.now().astimezone().strftime(FORMATO_FECHA),
    }).splitlines()


def destino_por_defecto(entrada):
    """documento.pdf -> documento_firmado.pdf (en la misma carpeta)."""
    ruta = pathlib.Path(entrada)
    return str(ruta.with_name(ruta.stem + "_firmado" + (ruta.suffix or ".pdf")))


def elegir_archivos(entrada, salida):
    """Completa por dialogo los archivos que no vinieron por linea de comandos.

    Devuelve (entrada, salida) o (None, None) si se cancela. El dialogo de
    destino viene precargado con <nombre>_firmado.pdf.
    """
    import tkinter as tk
    from tkinter import filedialog

    tipos = [("Documentos PDF", "*.pdf"), ("Todos los archivos", "*.*")]
    root = tk.Tk()
    root.withdraw()
    try:
        if entrada is None:
            entrada = filedialog.askopenfilename(
                title="Elegir el PDF a firmar", filetypes=tipos)
            if not entrada:
                return None, None
        if salida is None:
            sugerido = pathlib.Path(destino_por_defecto(entrada))
            salida = filedialog.asksaveasfilename(
                title="Guardar el PDF firmado como",
                initialdir=str(sugerido.parent), initialfile=sugerido.name,
                defaultextension=".pdf", filetypes=tipos)
            if not salida:
                return None, None
    finally:
        root.destroy()
    return entrada, salida


def pedir_pin_gui(titulo="Firma digital"):
    """Pide el PIN en una ventana. Devuelve None si el usuario cancela.

    Se usa cuando el area se eligio con el selector visual: saltar a la terminal
    a mitad del flujo es incomodo. En modo lote (--caja / --invisible) se sigue
    pidiendo por terminal con getpass.
    """
    import tkinter as tk

    resultado = {"pin": None}
    win = tk.Tk()
    win.title(titulo)
    win.resizable(False, False)

    marco = tk.Frame(win, padx=18, pady=14)
    marco.pack()
    tk.Label(marco, text="PIN del token", anchor="w").pack(fill="x")
    entrada = tk.Entry(marco, show="\u2022", width=28, font=("TkDefaultFont", 12))
    entrada.pack(pady=(4, 2))
    aviso = tk.Label(marco, fg="#a00", text="", anchor="w")
    aviso.pack(fill="x")

    def aceptar(*_):
        valor = entrada.get()
        if not valor:
            aviso.config(text="Ingresa el PIN")
            return
        resultado["pin"] = valor
        win.destroy()

    botones = tk.Frame(marco)
    botones.pack(fill="x", pady=(8, 0))
    tk.Button(botones, text="Cancelar", command=win.destroy).pack(side="right", padx=4)
    tk.Button(botones, text="Firmar", command=aceptar, default="active").pack(side="right")

    win.bind("<Return>", aceptar)
    win.bind("<Escape>", lambda e: win.destroy())
    entrada.focus_set()

    win.update_idletasks()
    x = (win.winfo_screenwidth() - win.winfo_width()) // 2
    y = (win.winfo_screenheight() - win.winfo_height()) // 3
    win.geometry(f"+{x}+{y}")
    win.attributes("-topmost", True)
    win.mainloop()
    return resultado["pin"]


def pedir_pin(usar_gui):
    """Un unico intento: un PIN equivocado cuenta como fallo en el token, que se
    bloquea a los 3 (ver docs/instalacion.md). Por eso no hay reintento."""
    hay_display = os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
    if usar_gui and hay_display:
        try:
            return pedir_pin_gui()
        except Exception:
            pass  # sin entorno grafico utilizable, cae a la terminal
    return getpass.getpass("PIN del token: ")


def main():
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("entrada", nargs="?", default=None,
                   help="PDF a firmar; si se omite, se elige por dialogo")
    p.add_argument("salida", nargs="?", default=None,
                   help="PDF de salida; por defecto <nombre>_firmado.pdf")
    p.add_argument("--caja", type=parse_caja, default=None, metavar="P:X1,Y1,X2,Y2",
                   help="posicion del sello en puntos PDF (origen abajo-izquierda); "
                        "salteando el selector visual. Para lotes")
    p.add_argument("--invisible", action="store_true",
                   help="firmar sin sello visible y sin abrir el selector")
    p.add_argument("--pagina", type=int, default=1,
                   help="pagina en la que abre el selector (default: 1)")
    p.add_argument("--campo", default="Firma1", help="nombre del campo de firma")
    p.add_argument("--sin-bloqueo", action="store_true",
                   help="no bloquear los campos tras firmar")
    p.add_argument("--tamano-fuente", type=int, default=None,
                   help="cuerpo del texto del sello; por defecto se calcula "
                        "el mayor que entre en la caja elegida")
    p.add_argument("--alineacion", choices=sorted(ALINEACIONES),
                   default="abajo-izq",
                   help="posicion del texto dentro del recuadro (default: "
                        "abajo-izq, que apoya el sello sobre la linea de firma)")
    p.add_argument("--forzar", action="store_true",
                   help="sobrescribir el archivo de salida si ya existe")
    p.add_argument("--pin-terminal", action="store_true",
                   help="pedir el PIN por terminal aunque se use el selector visual")
    p.add_argument("--motivo", default=None)
    p.add_argument("--lugar", default=None)
    g = p.add_argument_group("token (opcional: por defecto se autodetecta)")
    g.add_argument("--lib", default=None, metavar="RUTA",
                   help="modulo PKCS#11 del middleware")
    g.add_argument("--token-label", default=None)
    g.add_argument("--cert-label", default=None)
    g.add_argument("--key-label", default=None)
    a = p.parse_args()

    if a.invisible and a.caja is not None:
        p.error("--invisible y --caja son excluyentes")

    hay_display = os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY")
    if a.entrada is None:
        if not hay_display:
            p.error("sin entorno grafico hay que indicar el PDF a firmar")
        a.entrada, a.salida = elegir_archivos(None, a.salida)
        if a.entrada is None:
            print("Cancelado, no se firmo nada.", file=sys.stderr)
            return 1
    elif a.salida is None:
        # con la entrada dada por linea de comandos, el destino se deriva solo
        a.salida = destino_por_defecto(a.entrada)

    if not os.path.isfile(a.entrada):
        p.error(f"no existe el archivo {a.entrada}")
    if os.path.exists(a.salida) and not a.forzar:
        p.error(f"{a.salida} ya existe; usa --forzar o indica otro nombre")

    lib, token_label, cert_label, key_label = resolver_token(a)

    uso_selector = not a.invisible and a.caja is None
    if uso_selector:
        elegida = elegir_caja(
            a.entrada, a.pagina,
            leer_nombre_del_token(lib, token_label, cert_label), a.alineacion)
        if elegida is None:
            print("Cancelado, no se firmo nada.", file=sys.stderr)
            return 1
        a.caja = elegida
        print(f"Area elegida: --caja {a.caja[0]}:" + ",".join(map(str, a.caja[1])))

    pin = pedir_pin(uso_selector and not a.pin_terminal)
    if pin is None:
        print("Cancelado, no se firmo nada.", file=sys.stderr)
        return 1
    criterio = TokenCriteria(label=token_label) if token_label else None
    session = open_pkcs11_session(lib, token_criteria=criterio, user_pin=pin)
    try:
        # cert_label/key_label en None => pyHanko consulta solo por clase y toma
        # el unico objeto que haya (ver docs/diagnostico.md)
        signer = PKCS11Signer(session, cert_label=cert_label, key_label=key_label)

        spec_extra = {}
        meta_extra = {}
        if not a.sin_bloqueo:
            spec_extra.update(
                field_mdp_spec=fields.FieldMDPSpec(fields.FieldMDPAction.ALL),
                doc_mdp_update_value=fields.MDPPerm.NO_CHANGES,
            )
            # explicito: sin esto pyHanko pide FILL_FORMS por defecto, choca con
            # el spec del campo y emite una advertencia confusa
            meta_extra["docmdp_permissions"] = fields.MDPPerm.NO_CHANGES

        estilo = None
        text_params = None
        if a.caja is not None:
            pagina, box = a.caja
            spec_extra.update(on_page=pagina - 1, box=box)
            nombre = signer.signing_cert.subject.native.get("common_name", "")
            cuerpo = a.tamano_fuente
            if cuerpo is None:
                muestra = TEXTO_SELLO % {
                    "signer": nombre,
                    "ts": datetime.now().astimezone().strftime(FORMATO_FECHA),
                }
                cuerpo = cuerpo_que_entra(
                    muestra.splitlines(), box[2] - box[0], box[3] - box[1]
                )
            else:
                muestra = TEXTO_SELLO % {
                    "signer": nombre,
                    "ts": datetime.now().astimezone().strftime(FORMATO_FECHA),
                }
            estilo = TextStampStyle(
                stamp_text=TEXTO_SELLO,
                timestamp_format=FORMATO_FECHA,
                # inner_content_layout ubica el bloque dentro del recuadro del
                # sello; box_layout_rule solo acomoda el texto dentro de su
                # propia caja (por eso ahi va sin margenes)
                inner_content_layout=regla_de_caja(a.alineacion),
                text_box_style=pdftext.TextBoxStyle(
                    font=fuente(muestra.splitlines()), font_size=cuerpo,
                    leading=int(round(cuerpo * INTERLINEA)),
                    box_layout_rule=layout.SimpleBoxLayoutRule(
                        x_align=layout.AxisAlignment.ALIGN_MIN,
                        y_align=layout.AxisAlignment.ALIGN_MIN,
                        margins=layout.Margins.uniform(0),
                    ),
                ),
                border_width=0,   # Acrobat no dibuja recuadro
                background=None,
            )
            text_params = {"signer": nombre}

        with open(a.entrada, "rb") as fh:
            w = IncrementalPdfFileWriter(fh)
            fields.append_signature_field(
                w, fields.SigFieldSpec(sig_field_name=a.campo, **spec_extra)
            )
            meta = signers.PdfSignatureMetadata(
                field_name=a.campo, md_algorithm="sha256",
                reason=a.motivo, location=a.lugar, **meta_extra,
            )
            pdf_signer = PdfSigner(meta, signer=signer, stamp_style=estilo)
            with open(a.salida, "wb") as out:
                pdf_signer.sign_pdf(
                    w, existing_fields_only=True,
                    appearance_text_params=text_params, output=out,
                )
    finally:
        session.close()

    detalles = [] if a.sin_bloqueo else ["campos bloqueados"]
    detalles.append("invisible" if a.caja is None else f"sello en pagina {a.caja[0]}")
    print(f"Firmado: {a.salida} ({', '.join(detalles)})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
